<?xml version="1.0" encoding="utf-8"?>
<!--
  Google Play Data safety — canonical mapping for Rianell Android.
  Import reference for Play Console; keep in sync with docs/compliance/app-store-declarations.md
-->
<data-safety>
  <app name="Rianell" package="com.anonymous.mobile">
    <data-types>
      <health-fitness collected="true" shared="false" ephemeral="false" required="false">
        <purposes>
          <purpose>App functionality</purpose>
        </purposes>
        <encryption in-transit="true" on-device="true"/>
      </health-fitness>
      <email collected="optional" shared="false">
        <purposes>
          <purpose>Account management</purpose>
        </purposes>
        <encryption in-transit="true"/>
      </email>
      <crash-logs collected="optional" shared="false">
        <purposes>
          <purpose>Analytics</purpose>
        </purposes>
        <encryption in-transit="true"/>
      </crash-logs>
      <app-interactions collected="optional" shared="true" processor="Smartlook Analytics s.r.o.">
        <purposes>
          <purpose>Analytics</purpose>
        </purposes>
        <user-control>opt-in default after disclosure; revocable in Settings</user-control>
        <encryption in-transit="true"/>
        <region>EU</region>
      </app-interactions>
    </data-types>
    <security-practices>
      <practice>Data is encrypted in transit</practice>
      <practice>Users can request data deletion</practice>
      <practice>Committed to Play Families Policy where applicable</practice>
    </security-practices>
    <data-deletion>
      <in-app>true</in-app>
      <cloud-rpc>delete_all_user_data</cloud-rpc>
    </data-deletion>
  </app>
</data-safety>
