      "data_subjects": ["app_users"],
      "special_category": true,
      "recipients": [],
      "subprocessors": [],
      "storage_locations": ["device_local_storage", "device_async_storage", "indexeddb_optional"],
      "retention": "Until user deletes local data or uninstalls",
      "security_measures": [
        "OS_device_lock_recommended",
        "same_origin_policy_pwa",
        "no_app_level_encryption_at_rest_v1_49"
      ],
      "international_transfers": false,
      "dpia_reference": "docs/privacy/dpia-health-sync.md",
      "data_subject_rights": ["access", "rectification", "erasure", "portability", "withdraw_consent"]
