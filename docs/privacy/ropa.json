      "legal_basis_art6": "consent_6_1_a",
      "legal_basis_art9": "explicit_consent_9_2_a",
      "data_categories": [
        "health_metrics",
        "symptoms",
        "medications",
        "free_text_notes",
        "lifestyle_data"
